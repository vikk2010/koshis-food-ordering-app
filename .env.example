# Optional. The Firebase project config is built in (src/config/firebaseConfig.js), so no .env
# is needed. Copy to .env only to point at a different Firebase project or to use demo mode.

# true = run without Firebase (demo login with OTP on screen, orders only in this browser)
VITE_DEMO_MODE=false

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Customer login when Firebase is configured:
#   google = "Continue with Google" + mobile number (free, no SMS)
#   phone  = SMS OTP via Firebase Phone Auth (needs the Blaze plan; ~10 free SMS/day, then paid)
VITE_LOGIN_METHOD=google

# Admin panel password - demo mode only (it ends up in the client bundle).
# With Firebase configured, admins sign in with Google instead (UID listed in the "admins" collection).
VITE_ADMIN_PASSWORD=admin123
