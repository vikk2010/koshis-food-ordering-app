# Copy to .env and fill in to send real SMS OTPs via Firebase Phone Auth.
# Leave the Firebase values empty to use demo mode (OTP shown on screen).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Admin panel password (demo only - it ends up in the client bundle)
VITE_ADMIN_PASSWORD=admin123
